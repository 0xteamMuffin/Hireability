# Backend
JWT_EXPIRES_IN=1d
JWT_SECRET=your_jwt_secret_key
PORT=5000
# Use localhost when running the app on your host (e.g. npm run dev); Docker Compose overrides this for the backend container to use host "postgres"
DATABASE_URL=db_url
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-flash-latest
VAPI_API_KEY=

# # Frontend
# NEXT_PUBLIC_API_URL=http://localhost:5000
# NEXT_PUBLIC_VAPI_ASSISTANT_ID=your_vapi_assistant_id
# NEXT_PUBLIC_VAPI_PUBLIC_KEY=your_vapi_public_key

# Database (used by Docker postgres + injected into backend container as DATABASE_URL with host "postgres")
POSTGRES_USER=postgres
POSTGRES_PASSWORD=some_password
POSTGRES_DB=hireability